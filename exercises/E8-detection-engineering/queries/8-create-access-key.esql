// Detection : Cloud access key created outside an approved change
// MITRE     : T1098.001 - Account Manipulation: Additional Cloud Credentials
// Data view : vs-cloud
// Logic     : every CreateAccessKey, excluding the one that matches CHG-1190 on
//             user + target account + time window.
// Expected  : 1 row (2027-02-03 01:17:02 UTC, svc-etl-pipeline -> svc-backup-legacy)
// Extra signal: a service account creating a key for ANOTHER account, at night, no MFA
FROM vs-cloud
| WHERE event.action == "CreateAccessKey"
| WHERE NOT (COALESCE(labels.ticket, "") == "CHG-1190"
             AND user.name == "a.morales"
             AND aws.target_user == "svc-reporting"
             AND @timestamp >= "2027-02-04T15:00:00Z" AND @timestamp <= "2027-02-04T16:00:00Z")
| KEEP @timestamp, user.name, aws.target_user, aws.new_access_key_id, source.ip, mfa.used, labels.ticket, event.outcome
| SORT @timestamp ASC
