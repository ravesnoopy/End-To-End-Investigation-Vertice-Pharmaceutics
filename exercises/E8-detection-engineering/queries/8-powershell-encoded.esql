// Detection : Suspicious encoded PowerShell
// MITRE     : T1059.001 (PowerShell), T1027 (Obfuscated Files or Information)
// Data view : vs-endpoint
// Logic     : -EncodedCommand, excluding (a) SCCM-managed SYSTEM jobs and
//             (b) CHG-1187 ONLY when user + host + time window all match the ticket.
//             Labels are self-reported, so a label alone never suppresses an alert.
// Expected  : 3 rows (r.duarte on JMP-BR-01)
// Lead      : dataset returns 44 encoded commands, the brief says 46 -
//             also test variants such as -e / -ec / other casing.
FROM vs-endpoint
| WHERE TO_LOWER(process.command_line) LIKE "*-encodedcommand*"
| WHERE NOT (COALESCE(labels.managed_by, "") == "SCCM" AND user.name == "SYSTEM")
| WHERE NOT (COALESCE(labels.ticket, "") == "CHG-1187"
             AND user.name == "j.herrera"
             AND host.name IN ("JMP-MX-01", "APP-MX-01", "FS-MX-02", "SQL-MX-01")
             AND @timestamp >= "2027-02-04T02:00:00Z" AND @timestamp <= "2027-02-04T04:00:00Z")
| KEEP @timestamp, host.name, user.name, process.parent.name, labels.managed_by, labels.ticket
| SORT @timestamp ASC
