// 1) Change tickets: none covers 1–3 Feb
FROM vs-cambios
| KEEP ticket, descripcion, inicio_utc, fin_utc, hosts_o_cuentas, responsable, estado
| SORT inicio_utc ASC
| LIMIT 20

// 2) AL-1341: encoded commands on JMP-BR-01 have no ticket / managed_by label
FROM vs-endpoint
| WHERE host.name == "JMP-BR-01" AND TO_LOWER(process.command_line) LIKE "*-enc*"
| KEEP @timestamp, user.name, labels.managed_by, labels.ticket, process.parent.name, process.name
| SORT @timestamp ASC
| LIMIT 10

// 3) AL-1340: unapproved pushes from NL
FROM vs-auth
| WHERE user.name == "r.duarte" AND @timestamp >= "2027-02-02T02:00:00Z" AND @timestamp < "2027-02-02T03:15:00Z"
| KEEP @timestamp, event.dataset, event.action, mfa.result, event.outcome, source.ip, source.geo.country_iso_code, vpn.assigned_ip
| SORT @timestamp ASC
| LIMIT 50

// 4) AL-1340: baseline of r.duarte before 2 Feb (only 198.18.32.180 / BR)
FROM vs-auth
| WHERE user.name == "r.duarte" AND @timestamp < "2027-02-02T02:00:00Z"
| STATS events = COUNT(*) BY source.ip, source.geo.country_iso_code, event.dataset
| SORT events DESC
| LIMIT 20

// 5) AL-1348: the POST to the fake domain
FROM vs-network
| WHERE (source.hostname == "BR-LT-0231" OR destination.ip == "198.51.100.201")
    AND @timestamp >= "2027-02-01T12:00:00Z" AND @timestamp < "2027-02-02T04:00:00Z"
| KEEP @timestamp, event.dataset, source.hostname, source.ip, destination.ip, url.domain, url.path, http.request.method, http.response.status_code, event.action
| SORT @timestamp ASC
| LIMIT 50

// 6) AL-1342: the two CreateAccessKey events
FROM vs-cloud
| WHERE event.action == "CreateAccessKey"
| KEEP @timestamp, user.name, aws.target_user, aws.access_key_id, aws.new_access_key_id, source.ip, mfa.used, labels.ticket, labels.note, event.outcome, user_agent.original
| SORT @timestamp ASC
| LIMIT 10
