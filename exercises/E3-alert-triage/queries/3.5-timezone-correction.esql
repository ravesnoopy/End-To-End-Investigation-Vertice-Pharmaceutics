// UTC version (vs-alerts)
FROM vs-alerts
| WHERE alert.id == "AL-1340"
| KEEP @timestamp, alert.id, rule.name, alert.severity, alert.status, alert.closed_by, alert.closure_note

// Local-time CSV export (UTC-6): 2027-02-01 20:44:30  →  2027-02-02 02:44:30 UTC
FROM vs-alertas-cdmx
| WHERE alert_id == "AL-1340"
| KEEP alert_id, fecha_hora_local, regla, severidad, estado, cerrada_por, usuario, host
